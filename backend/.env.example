# ERSUS 360 — Backend Environment Variables
# Copie para .env e preencha os valores reais

# ── Aplicação ──────────────────────────────────────────────────────
APP_NAME=ERSUS 360
DEBUG=false

# ── Banco de dados ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ersus360.db
# Para PostgreSQL (produção):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ersus360

# ── Segurança JWT ──────────────────────────────────────────────────
SECRET_KEY=gere-com-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Município piloto ───────────────────────────────────────────────
MUNICIPIO_NOME=Apuí
MUNICIPIO_UF=AM
MUNICIPIO_IBGE=1300144

# ── CORS (Vercel URL em produção) ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://ersus360.vercel.app

# ── Integrações SUS (valores reais apenas em Railway) ──────────────
# FNS / SIOPS
FNS_API_URL=https://api-horus.saude.gov.br
FNS_API_CPF=
FNS_API_SENHA=

# e-SUS PEC
ESUS_BASE_URL=http://localhost:8080
ESUS_USUARIO=
ESUS_SENHA=

# CNES / DATASUS (público, não precisa de credenciais)
CNES_BASE_URL=https://cnes.datasus.gov.br

# ── IA Gestora (Anthropic Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Upload de arquivos ─────────────────────────────────────────────
UPLOAD_DIR=/tmp/ersus360/obras
