# ERSUS360 — Agente PEC Local
# Renomeie este arquivo para .env e preencha os valores

# ── Banco de dados PostgreSQL local do e-SUS PEC ──────────────────────────────
PEC_DB_HOST=localhost
PEC_DB_PORT=5432
PEC_DB_NAME=esus
PEC_DB_USER=esus
PEC_DB_PASS=SUA_SENHA_AQUI

# ── Railway (backend ERSUS360) ────────────────────────────────────────────────
RAILWAY_URL=https://ersus360-production.up.railway.app
# Chave de sincronização — copie do Railway > Variables > ERSUS_SYNC_KEY
ERSUS_SYNC_KEY=SUA_CHAVE_AQUI
